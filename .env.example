# Copy to .env.local for local development, and add the same three variables in Vercel (Project Settings -> Environment Variables).
# Never commit real keys.

# Supabase project URL, e.g. https://abcdefgh.supabase.co  (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable key (sb_publishable_...) or the legacy anon key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# SECRET key (sb_secret_...) or the legacy service_role key. SERVER ONLY: used by /api routes. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
